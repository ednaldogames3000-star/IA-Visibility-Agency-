# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Optional alias supported by the app
# POSTGRES_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
DB_SSL=true
DB_POOL_MAX=10

# Admin authentication
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=generate-with-createPasswordHash

# Reverse proxy: true only when the app is actually behind a trusted proxy
TRUST_PROXY=false
PORT=3000
NODE_ENV=production
