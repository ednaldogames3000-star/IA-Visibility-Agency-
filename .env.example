# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Optional alias supported by the app
# POSTGRES_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Use false only for a local database that does not provide TLS.
DB_SSL=true
# Keep small on serverless; raise only with a database that supports the load.
DB_POOL_MAX=3

# Admin authentication
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=generate-with-createPasswordHash

# Reverse proxy: true only when the app is actually behind a trusted proxy
TRUST_PROXY=false
PORT=3000
NODE_ENV=production
